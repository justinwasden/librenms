<?php

namespace App\RestApi\Utils;

/**
 * JsonPathExtractor
 * 
 * Extracts values from nested JSON using JSONPath syntax
 */
class JsonPathExtractor
{
    /**
     * Extract value from array using JSONPath
     */
    public static function extract(array $data, string $path): mixed
    {
        if (str_starts_with($path, '$')) {
            $path = substr($path, 1);
        }

        if (str_starts_with($path, '.')) {
            $path = substr($path, 1);
        }

        if (empty($path)) {
            return $data;
        }

        return self::navigatePath($data, $path);
    }

    private static function navigatePath(array &$data, string $path): mixed
    {
        if (str_contains($path, '[*]')) {
            return self::handleWildcardArray($data, $path);
        }

        $segments = self::parsePath($path);

        $current = $data;
        foreach ($segments as $segment) {
            if ($current === null) {
                return null;
            }

            if (!is_array($current)) {
                return null;
            }

            if (preg_match('/^(\w+)\[(\d+)\]$/', $segment, $matches)) {
                $key = $matches[1];
                $index = (int)$matches[2];

                if (!isset($current[$key])) {
                    return null;
                }

                $array = $current[$key];
                if (!is_array($array)) {
                    return null;
                }

                $current = $array[$index] ?? null;
                continue;
            }

            if (isset($current[$segment])) {
                $current = $current[$segment];
                continue;
            }

            return null;
        }

        return $current;
    }

    private static function handleWildcardArray(array &$data, string $path): mixed
    {
        if (preg_match('/^([^[]*)\[\*\]\.?(.*)$/', $path, $matches)) {
            $beforeWildcard = $matches[1];
            $afterWildcard = $matches[2];

            $current = $data;
            if ($beforeWildcard) {
                $beforeSegments = self::parsePath($beforeWildcard);
                foreach ($beforeSegments as $segment) {
                    if (!is_array($current) || !isset($current[$segment])) {
                        return null;
                    }
                    $current = $current[$segment];
                }
            }

            if (!is_array($current)) {
                return null;
            }

            if (empty($current)) {
                return null;
            }

            $first = reset($current);
            if ($afterWildcard && is_array($first)) {
                return self::navigatePath($first, $afterWildcard);
            }

            return $first;
        }

        return null;
    }

    private static function parsePath(string $path): array
    {
        $segments = [];
        $current = '';
        $inBracket = false;

        for ($i = 0; $i < strlen($path); $i++) {
            $char = $path[$i];

            if ($char === '[') {
                $inBracket = true;
                $current .= $char;
            } elseif ($char === ']') {
                $inBracket = false;
                $current .= $char;
            } elseif ($char === '.' && !$inBracket) {
                if (!empty($current)) {
                    $segments[] = $current;
                    $current = '';
                }
            } else {
                $current .= $char;
            }
        }

        if (!empty($current)) {
            $segments[] = $current;
        }

        return $segments;
    }
}
